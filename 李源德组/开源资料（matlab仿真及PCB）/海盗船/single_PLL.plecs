"\n"
"\n"
"#include \"math.h\"\n"
"\n"
"#define  float float\n"
"\n"
"#define FSW 20e3\n"
"\n"
"#define ssrf_ts             1/FSW\n"
"#define ssrf_kp             1.007f\n"
"#define sser_ki             0.006f\n"
"#define ssrf_up_limt        63\n"
